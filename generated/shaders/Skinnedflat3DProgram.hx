  return [{stride: 24, instanced: false, attributes: [{slot: 0, componentCount: 3, offset: 0}, {slot: 1, componentCount: 3, offset: 12}]}, {stride: 144, instanced: true, attributes: [{slot: 2, componentCount: 4, offset: 0}, {slot: 3, componentCount: 4, offset: 16}, {slot: 4, componentCount: 4, offset: 32}, {slot: 5, componentCount: 4, offset: 48}, {slot: 6, componentCount: 4, offset: 64}, {slot: 7, componentCount: 4, offset: 80}]}, {stride: 32, instanced: false, attributes: [{slot: 8, componentCount: 4, offset: 0}, {slot: 9, componentCount: 4, offset: 16}]}];
}
