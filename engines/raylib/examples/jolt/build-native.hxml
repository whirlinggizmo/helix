# The stack natively, SDL3 drawing with GL and Jolt compiled in: haxe build-native.hxml -> native/Main; hxcpp links the SDL3 library
# HELIX_SDL3_LIBRARY names (BUILDING.md). --quit_after_frame=60 quits it after frame 60.
-lib helix-raylib
-lib helix-jolt
-D helix-company=helix
-D helix-product=raylib-jolt
-cp .
-main Main
-D helix-raylib-portable-sys
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
