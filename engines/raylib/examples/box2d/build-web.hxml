# The pyramid in a page: haxe build-web.hxml -> web/app.js, and box2d.wasm copied beside it and web/index.html; serve web/ and open it
# (?quit_after_frame=60 quits after frame 60).
-lib helix-raylib
-lib helix-box2d
-D helix-company=helix
-D helix-product=raylib-box2d
-cp .
-main Main
-D helix-raylib-portable-sys
-dce full
-js web/app.js
--macro helix.box2d.Box2D.copyWasm("web")
