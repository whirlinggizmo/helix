# The fountain in a page: haxe build-web.hxml -> web/app.js, beside web/index.html; serve web/ and open it (?quit_after_frame=60
# quits after frame 60).
-lib helix-raylib
-D helix-company=helix
-D helix-product=raylib-extras-particles3d
-cp .
-main Main
-D helix-raylib-portable-sys
-dce full
-js web/app.js
