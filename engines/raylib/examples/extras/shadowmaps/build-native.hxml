# The shadowmaps natively, SDL3 drawing with GL: haxe build-native.hxml -> native/Main; hxcpp links the SDL3 library HELIX_SDL3_LIBRARY
# names (BUILDING.md). --quit_after_frame=60 quits it after frame 60. The build compiles raylib's shadowmap shaders into
# web/assets/shadowmap.shader.
-lib helix-raylib
-D helix-company=helix
-D helix-product=raylib-extras-shadowmaps
-cp .
-main Main
--macro helix.raylib.Raylib.CompileShaderFile("shadowmap.vs", "shadowmap.fs", "web/assets/shadowmap.shader")
-D helix-raylib-portable-sys
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
