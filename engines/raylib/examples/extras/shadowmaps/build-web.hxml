# The shadowmaps in a page: haxe build-web.hxml -> web/app.js, beside web/index.html; serve web/ and open it (?quit_after_frame=60
# quits after frame 60). The build compiles raylib's shadowmap shaders into web/assets/shadowmap.shader.
-lib helix-raylib
-D helix-company=helix
-D helix-product=raylib-extras-shadowmaps
-cp .
-main Main
--macro helix.raylib.Raylib.CompileShaderFile("shadowmap.vs", "shadowmap.fs", "web/assets/shadowmap.shader")
-D helix-raylib-portable-sys
-dce full
-js web/app.js
