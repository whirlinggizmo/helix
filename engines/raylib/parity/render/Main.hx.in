import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.extras.Shaders.*;
import helix.raylib.extras.Window.*;
import helix.raylib.extras.Textures.*;
import helix.raylib.Rlgl.*;
import helix.raylib.Raymath.*;

// scene.c.in's render state and render texture scene, drawn by helix-raylib; its third frame saved as helix.png. cases.py's list is put into
// it.
class Main {
	static function V2(x:Float, y:Float):Vector2
		return new Vector2(x, y);

	static function R(x:Float, y:Float, w:Float, h:Float):Rectangle
		return new Rectangle(x, y, w, h);

	static function main():Void {
		InitWindow(640, 480, "render");
		var target = LoadRenderTexture(200, 100);
		var checks = LoadTextureFromImage(GenImageChecked(64, 64, 8, 8, ORANGE, DARKBLUE));
		var red = GenImageColor(32, 32, RED);
		var tile = GenImageChecked(8, 8, 2, 2, GREEN, BLUE);
		var patched = LoadTextureFromImage(red);
		var second = LoadTextureFromImage(red);
		var copy = LoadRenderTexture(32, 32);
		var ramp = GenImageGradientLinear(16, 16, 90, BLACK, WHITE);
		ImageFormat(ramp, PIXELFORMAT_UNCOMPRESSED_GRAYSCALE);
		var dark = GenImageColor(8, 4, DARKGRAY);
		ImageFormat(dark, PIXELFORMAT_UNCOMPRESSED_GRAYSCALE);
		var gray = LoadTextureFromImage(ramp);
		var trail = LoadRenderTexture(200, 60);
		var squares = GenImageChecked(64, 64, 16, 16, RED, BLUE);
		var filters = [TEXTURE_FILTER_POINT, TEXTURE_FILTER_BILINEAR, TEXTURE_FILTER_TRILINEAR, TEXTURE_FILTER_ANISOTROPIC_16X];
		var mipped = [for (i in 0...4) LoadTextureFromImage(squares)];
		for (i in 0...4) {
			GenTextureMipmaps(mipped[i]);
			if (i == 3)
				SetTextureFilter(mipped[i], TEXTURE_FILTER_TRILINEAR);
			SetTextureFilter(mipped[i], filters[i]);
		}
		var late = LoadTextureFromImage(squares);
		var plain = LoadTextureFromImage(squares);
		SetTextureFilter(plain, TEXTURE_FILTER_TRILINEAR);
		var camera = new Camera(new Vector3(-5.5, 16, 10), new Vector3(-5.5, 0, -6), new Vector3(0, 1, 0), 45, CAMERA_PERSPECTIVE);
		var cube = GenMeshCube(1, 1, 1);
		var instancing:Shader = null;
		var placed = LoadMaterialDefault();
		LoadCompiledShaderAsync("instancing.shader", loaded -> {
			instancing = loaded;
			instancing.locs[SHADER_LOC_MATRIX_MODEL] = GetShaderLocationAttrib(instancing, "instanceTransform");
			placed.shader = instancing;
		});
		placed.maps[MATERIAL_MAP_DIFFUSE].color = new Color(250, 220, 180, 255);
		var transforms = [for (i in 0...9) MatrixMultiply(MatrixRotateY(i * 0.4), MatrixTranslate(i % 3 * 2 - 2, 0, Std.int(i / 3) * 2 - 2))];
		var readBack:Texture2D = null;
		var frame = 0;
		while (!WindowShouldClose()) {
			// Drawn once the shader is loaded.
			if (instancing == null) {
				BeginDrawing();
				EndDrawing();
				continue;
			}
			BeginDrawing();
			ClearBackground(RAYWHITE);
			@CASES@
			if (frame == 2)
				TakeScreenshotAsync("helix.png");
			EndDrawing();
			frame++;
		}
		CloseWindow();
	}
}
