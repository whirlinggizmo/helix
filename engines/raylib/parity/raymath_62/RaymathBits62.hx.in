import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.Raymath.*;
import Parity.*;

// helix-raylib's raymath functions taken from raylib 6.2, printed by Parity and the printers here as ref.c.in prints raylib's.
class RaymathBits62 {
	static function v3(name:String, v:Vector3):Void
		line('$name v3 ${v.x} ${v.y} ${v.z}');

	static function v4(name:String, v:Vector4):Void
		line('$name v4 ${v.x} ${v.y} ${v.z} ${v.w}');

	static function floats(name:String, v:Array<Float>):Void
		line('$name floats ${v.join(" ")}');

	static function mat(name:String, m:Matrix):Void
		floats(name, [m.m0, m.m1, m.m2, m.m3, m.m4, m.m5, m.m6, m.m7, m.m8, m.m9, m.m10, m.m11, m.m12, m.m13, m.m14, m.m15]);

	static function main() {
		open();
		@CASES@
		save();
	}
}
