import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.Raymath.*;
import Parity.*;

// helix-raylib's 3D ray tests and collision checks, printed by Parity as ref.c.in prints raylib's.
class CollisionBits {
	static function main() {
		open();
		var box = new BoundingBox(V3(-1, -1, -1), V3(1, 2, 1));
		@CASES@
		save();
	}
}
