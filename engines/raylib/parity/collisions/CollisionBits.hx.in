import helix.ray.*;
import helix.ray.Raylib.*;
import helix.ray.Raymath.*;
import Parity.*;

// helix-ray's 3D ray tests and collision checks, printed by Parity as ref.c.in prints raylib's.
class CollisionBits {
	static function main() {
		open();
		var box = new BoundingBox(V3(-1, -1, -1), V3(1, 2, 1));
		@CASES@
		save();
	}
}
