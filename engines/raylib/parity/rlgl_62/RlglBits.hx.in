import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.Rlgl.*;
import helix.raylib.internal.Runtime;
import helix.raylib.internal.Textures;
import Parity.*;

// helix-raylib's rlgl, read back from its frame, printed by Parity and the printers here as ref.c.in prints raylib 6.2's.
@:access(helix.raylib.internal.Frame)
class RlglBits {
	static var tex:Texture2D;
	static var tex2:Texture2D;

	// What was drawn since the last drawn: each vertex's mode, the texture its draw call draws with (white, tex or tex2) and its
	// position. The frame is drawn after.
	static function drawn(name:String):Void {
		var f = Runtime.frame;
		f.flush();
		for (d in f.pass.draws) {
			if (d.buffers != null)
				continue;
			var texture = d.texture == Textures.handle(tex.id) ? "tex" : d.texture == Textures.handle(tex2.id) ? "tex2" : d.texture == f.white ? "white" : "other";
			if (d.sprite) {
				// A sprite run: each record's quad as rlgl's batch holds it, its two triangles' corners 0 1 2 and 0 2 3, flat.
				for (i in d.firstInstance...d.firstInstance + d.instances)
					for (c in [0, 1, 2, 0, 2, 3])
						line('$name T $texture ${f.spriteData.getFloat(i * 52 + c * 8)} ${f.spriteData.getFloat(i * 52 + c * 8 + 4)} 0');
				continue;
			}
			for (k in d.first...d.first + d.count) {
				// Quads drawn through their indices, each one's four corners as two triangles, 0 1 2 and 0 2 3.
				var i = d.indices == 0 ? k : Std.int(k / 6) * 4 + [0, 1, 2, 0, 2, 3][k % 6];
				var at = i * 36;
				line('$name ${d.primitive == Lines ? "L" : "T"} $texture ${f.data.getFloat(at)} ${f.data.getFloat(at + 4)} ${f.data.getFloat(at + 8)}');
			}
		}
		line('$name end');
		f.draw(64, 64, true);
	}

	static function tri(x:Float):Void {
		rlVertex3f(x, 0, 0);
		rlVertex3f(x + 1, 0, 0);
		rlVertex3f(x, 1, 0);
	}

	static function quad(x:Float):Void {
		rlVertex3f(x, 0, 0);
		rlVertex3f(x, 1, 0);
		rlVertex3f(x + 1, 1, 0);
		rlVertex3f(x + 1, 0, 0);
	}

	static function seg(x:Float):Void {
		rlVertex3f(x, 0, 0);
		rlVertex3f(x, 1, 0);
	}

	static function main() {
		open();
		tex = LoadTextureFromImage(GenImageColor(4, 4, RED));
		tex2 = LoadTextureFromImage(GenImageColor(4, 4, BLUE));
		@CASES@
		save();
	}
}
