import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.Rlgl.*;
import Parity.*;

// helix-raylib's 3D shapes and billboards (read back from its frame), printed by Parity as ref.c.in prints raylib's.
class ShapeBits3D {
	static function main() {
		open();
		var c = new Color(200, 100, 50, 255), p = V3(1, 2, 3);
		var texture = LoadTextureFromImage(GenImageColor(32, 16, WHITE));
		var camera = new Camera(V3(3, 4, 10), V3(0, 1, 0), V3(0, 1, 0), 45, CAMERA_PERSPECTIVE);
		@CASES@
		save();
	}
}
