import helix.raylib.*;
import helix.raylib.Raylib.*;
import helix.raylib.Extras.*;

// scene.c.in's 3D scene, drawn by helix-raylib; its third frame saved as helix.png. cases.py's list is put into it.
class Main {
	static function V2(x:Float, y:Float):Vector2
		return new Vector2(x, y);

	static function V3(x:Float, y:Float, z:Float):Vector3
		return new Vector3(x, y, z);

	static function R(x:Float, y:Float, w:Float, h:Float):Rectangle
		return new Rectangle(x, y, w, h);

	static function main():Void {
		InitWindow(640, 360, "scene");
		var camera = new Camera(new Vector3(7, 6, 10), new Vector3(0, 0.5, 0), new Vector3(0, 1, 0), 45, CAMERA_PERSPECTIVE);
		var checks = LoadTextureFromImage(GenImageChecked(64, 64, 8, 8, ORANGE, DARKBLUE));
		var height = GenImageColor(8, 8, BLACK);
		for (y in 0...8)
			for (x in 0...8) {
				var g = (x * 37 + y * 23) % 256;
				ImageDrawPixel(height, x, y, new Color(g, g, g, 255));
			}
		var cubic = GenImageColor(4, 3, BLACK);
		var walls = [1, 1, 1, 1, 1, 0, 0, 1, 1, 0, 1, 1];
		for (i in 0...12)
			ImageDrawPixel(cubic, i % 4, Std.int(i / 4), walls[i] == 1 ? WHITE : BLACK);
		var meshes = [
			GenMeshPoly(6, 0.6), GenMeshPlane(1.2, 1.2, 3, 3), GenMeshCube(1, 1, 1), GenMeshSphere(0.6, 10, 14), GenMeshHemiSphere(0.6, 8, 12),
			GenMeshCylinder(0.5, 1, 12), GenMeshCone(0.6, 1.2, 10), GenMeshTorus(0.3, 1.2, 16, 10), GenMeshKnot(1, 0.8, 32, 8),
			GenMeshHeightmap(height, new Vector3(1.2, 0.6, 1.2)), GenMeshCubicmap(cubic, new Vector3(0.3, 0.4, 0.3))
		];
		var models = [for (m in meshes) LoadModelFromMesh(m)];
		for (m in models)
			SetMaterialTexture(m.materials[0], MATERIAL_MAP_DIFFUSE, checks);
		var shader = LoadShaderFromMemory("#version 330\nin vec3 vertexPosition;\nin vec4 vertexTangent;\nin vec2 vertexTexCoord2;\nuniform mat4 mvp;\nout vec4 c;\nvoid main() { c = vec4(vertexTangent.xyz*0.5 + 0.5, 1.0) + vec4(vertexTexCoord2, 0.0, 0.0); gl_Position = mvp*vec4(vertexPosition, 1.0); }\n",
			"#version 330\nin vec4 c;\nout vec4 finalColor;\nvoid main() { finalColor = c; }\n");
		var strip = [V3(-1, 0, 0.5), V3(-0.5, 0, 0.5), V3(-1, 0.6, 0.2), V3(-0.5, 0.6, 0.2), V3(-1, 1.2, 0), V3(-0.5, 1.2, 0)];
		var frame = 0;
		while (!WindowShouldClose()) {
			BeginDrawing();
			ClearBackground(RAYWHITE);
			BeginMode3D(camera);
			DrawGrid(12, 1);
			@CASES@
			EndMode3D();
			if (frame == 2)
				TakeScreenshotAsync("helix.png");
			EndDrawing();
			frame++;
		}
		CloseWindow();
	}
}
