# The window tests in a page: haxe build-web.hxml -> web/app.js, beside web/index.html; serve web/ and open it in a browser.
# window.helixResult holds {passed, checks, failures, answers} when they're done. helix-platform alone: haxelib dev helix-platform
# <checkout>/libs/platform first.
-lib helix-platform
-cp .
-main WindowTests
-dce full
-js web/app.js
