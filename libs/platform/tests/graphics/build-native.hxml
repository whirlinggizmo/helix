# The graphics tests natively, SDL3 drawing with GL: haxe build-native.hxml -> native/GraphicsTests; hxcpp compiles the adapters' C with it
# and links the SDL3 library HELIX_SDL3_LIBRARY names (BUILDING.md). It prints {passed, checks, failures} and exits 1 on a failure.
-lib helix-platform
-D helix-company=helix
-D helix-product=platform-graphics-tests
-cp .
-main GraphicsTests
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
