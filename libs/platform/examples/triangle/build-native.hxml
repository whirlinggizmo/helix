# The triangle natively, SDL3 drawing with GL: haxe build-native.hxml -> native/Main; hxcpp compiles the adapters' C with it and links
# the SDL3 library HELIX_SDL3_LIBRARY names (BUILDING.md). --quit_after_frame=60 quits it after frame 60.
-lib helix-platform
-D helix-company=helix
-D helix-product=platform-triangle
-cp .
-main Main
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
