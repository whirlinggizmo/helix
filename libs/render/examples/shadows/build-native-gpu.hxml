# The shadows example natively, SDL3 drawing with SDL_GPU (Vulkan, Direct3D 12 or Metal): haxe build-native-gpu.hxml -> native-gpu/Main.
# --quit_after_frame=60 quits it after frame 60.
-lib helix-render
-D helix-company=helix
-D helix-product=render-shadows
-cp .
-cp ..
-main Main
-D sdl_gpu
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native-gpu
