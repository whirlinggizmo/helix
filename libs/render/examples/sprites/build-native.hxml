# The sprites example natively, SDL3 drawing with GL: haxe build-native.hxml -> native/Main, reading web/assets; hxcpp links the SDL3
# library HELIX_SDL3_LIBRARY names (BUILDING.md). --quit_after_frame=60 quits it after frame 60.
-lib helix-render
-D helix-company=helix
-D helix-product=render-sprites
-cp .
-cp ..
-main Main
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
