# The patch example in a page: haxe build-web.hxml -> web/app.js, beside web/index.html; serve web/ and open it (?quit_after_frame=60 quits
# after frame 60). The server's manifests are written as it builds.
-lib helix-services
-D helix-company=helix
-D helix-product=patch-example
-cp .
-main Main
-dce full
--macro helix.services.tools.AssetManifests.write("web/cdn")
--macro helix.services.tools.AssetManifests.write("web/cdn-updated")
--macro helix.services.tools.AssetManifests.write("web/cdn-dropped")
-js web/app.js
