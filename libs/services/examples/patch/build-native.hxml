# The patch example natively: haxe build-native.hxml -> native/Main, linking the SDL3 library HELIX_SDL3_LIBRARY names (BUILDING.md).
# --quit_after_frame=60 quits it after frame 60. The shipped files' and the server's manifests are written as it builds.
-lib helix-services
-D helix-company=helix
-D helix-product=patch-example
-cp .
-main Main
-dce full
--macro helix.services.tools.AssetManifests.write("shipped")
--macro helix.services.tools.AssetManifests.write("web/cdn")
--macro helix.services.tools.AssetManifests.write("web/cdn-updated")
--macro helix.services.tools.AssetManifests.write("web/cdn-dropped")
-D HXCPP_COMPILE_THREADS=4
-cpp native
