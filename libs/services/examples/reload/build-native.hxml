# The reload example natively: haxe build-native.hxml -> native/Main, linking the SDL3 library HELIX_SDL3_LIBRARY names (BUILDING.md).
# --frames=60 stops it after 60 frames.
-lib helix-services
-D helix-company=helix
-D helix-product=reload-example
-D helix-asset-directory=native/assets
-cp .
-main Main
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
