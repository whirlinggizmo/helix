# The stream example natively: haxe build-native.hxml -> native/Main, linking the SDL3 library HELIX_SDL3_LIBRARY names (BUILDING.md).
# --quit_after_frame=60 quits it after frame 60.
-lib helix-services
-D helix-company=helix
-D helix-product=stream-example
-cp .
-main Main
-dce full
-D HXCPP_COMPILE_THREADS=4
-cpp native
