# The falling box in Node, as a page runs it, over jolt.wasm: haxe build-node.hxml -> main.js, and jolt.wasm copied beside it;
# node main.js from this directory.
-lib helix-jolt
-D helix-company=helix
-D helix-product=jolt-falling
-cp .
-main Main
-dce full
-js main.js
--macro helix.jolt.Jolt.copyWasm(".")
