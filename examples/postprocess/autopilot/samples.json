    {"op": "press", "key": "H"},
    {"op": "assert", "probe": "hdr", "equals": true},
    {"op": "sample", "name": "hdr", "points": [[400, 300], [200, 450], [600, 450], [60, 560], [740, 480], [400, 520]]},
    {"op": "sample", "name": "hdrEdges", "points": [[60, 560], [740, 480], [40, 300], [760, 300]]},
    {"op": "press", "key": "1"},
    {"op": "assert", "probe": "vignette", "equals": false},
    {"op": "sample", "name": "vignetteOff", "points": [[60, 560], [740, 480], [40, 300], [760, 300]], "differsFrom": "hdrEdges", "by": 4}
  ]
}
