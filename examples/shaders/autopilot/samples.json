    {"op": "sample", "name": "dissolving", "points": [[586, 462], [531, 440]]},
    {"op": "press", "key": "5"},
    {"op": "assert", "probe": "dissolving", "equals": false},
    {"op": "sample", "name": "whole", "points": [[586, 462], [531, 440]], "differsFrom": "dissolving", "by": 20},
    {"op": "press", "key": "5"},
    {"op": "press", "key": "C"},
    {"op": "assert", "probe": "closeUp", "equals": true},
    {"op": "sample", "name": "outlined", "points": [[570, 258], [310, 261]]},
    {"op": "press", "key": "3"},
    {"op": "assert", "probe": "outlines", "equals": false},
    {"op": "sample", "name": "outlinesOff", "points": [[570, 258], [310, 261]], "differsFrom": "outlined", "by": 20},
    {"op": "press", "key": "3"},
    {"op": "sample", "name": "silhouette", "points": [[650, 523], [659, 456]]},
    {"op": "press", "key": "4"},
    {"op": "assert", "probe": "silhouette", "equals": false},
    {"op": "sample", "name": "silhouetteOff", "points": [[650, 523], [659, 456]], "differsFrom": "silhouette", "by": 20},
    {"op": "press", "key": "4"},
    {"op": "sample", "name": "toon", "points": [[650, 123], [637, 328]]},
    {"op": "press", "key": "6"},
    {"op": "assert", "probe": "toon", "equals": false},
    {"op": "sample", "name": "toonOff", "points": [[650, 123], [637, 328]], "differsFrom": "toon", "by": 8},
    {"op": "press", "key": "6"},
    {"op": "sample", "name": "unflashed", "points": [[637, 181], [634, 245], [378, 392]]},
    {"op": "press", "key": "F"},
    {"op": "sample", "name": "flashed", "points": [[637, 181], [634, 245], [378, 392]], "differsFrom": "unflashed", "by": 40}
  ]
}
