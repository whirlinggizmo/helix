// raylib 6.2's font atlases and fonts from images, printed by parity.h and the printers here; cases.py's list is put into it.
#include "parity.h"
#include <stdlib.h>

// n glyphs, the ith w0 + (i*dw)%wm wide and h0 + i%hm high, their texels a pattern of their place; values from 32.
static GlyphInfo *glyphs(int n, int w0, int dw, int wm, int h0, int hm) {
    GlyphInfo *g = calloc(n, sizeof(GlyphInfo));
    for (int i = 0; i < n; i++) {
        int w = w0 + (i * dw) % wm, h = h0 + i % hm;
        unsigned char *data = malloc(w * h > 0 ? w * h : 1);
        for (int y = 0; y < h; y++)
            for (int x = 0; x < w; x++) data[y * w + x] = (unsigned char)((x * 7 + y * 13 + i * 3) & 255);
        g[i].value = 32 + i;
        g[i].image = (Image){ data, w, h, 1, PIXELFORMAT_UNCOMPRESSED_GRAYSCALE };
    }
    return g;
}

// An image's size and format, and a checksum of its bytes.
static void pixels(const char *name, Image image, int bytes) {
    long sum = 0;
    int lit = 0;
    for (int i = 0; i < bytes; i++) {
        int b = ((unsigned char *)image.data)[i];
        sum = (sum + b * (i % 251 + 1)) % 1000000007;
        if (b != 0) lit++;
    }
    printf("%s image %d %d %d %ld %d\n", name, image.width, image.height, image.format, sum, lit);
}

static void atlas(const char *name, GlyphInfo *g, int n, int fontSize, int padding, int pack) {
    Rectangle *recs = NULL;
    Image a = GenImageFontAtlas(g, &recs, n, fontSize, padding, pack);
    pixels(name, a, a.width * a.height * 2);
    for (int i = 0; i < (n > 0 ? n : 95); i++) rect(name, recs[i]);
}

static void font(const char *name, Font f) {
    printf("%s font %d %d %d %d %d\n", name, f.baseSize, f.glyphCount, f.glyphPadding, f.texture.width, f.texture.height);
    for (int i = 0; i < f.glyphCount; i++) {
        GlyphInfo g = f.glyphs[i];
        printf("%s glyph %d %d %d %d %d %d\n", name, g.value, g.offsetX, g.offsetY, g.advanceX, g.image.width, g.image.height);
        rect(name, f.recs[i]);
    }
}

int main(void) {
    parity_open();
    @CASES@
    parity_close();
    return 0;
}
