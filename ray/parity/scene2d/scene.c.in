// The 2D scene Main.hx.in draws, drawn by raylib, its third frame saved as ref.png; cases.py's list is put into it.
#include "raylib.h"
#include "rlgl.h"
#define V2(x, y) ((Vector2){ (float)(x), (float)(y) })
#define R(x, y, w, h) ((Rectangle){ (float)(x), (float)(y), (float)(w), (float)(h) })
int main(void) {
    SetTraceLogLevel(LOG_WARNING);
    InitWindow(800, 600, "scene2d");
    Texture2D checks = LoadTextureFromImage(GenImageChecked(64, 64, 8, 8, ORANGE, DARKBLUE));
    Font font = GetFontDefault();
    RenderTexture2D target = LoadRenderTexture(100, 60);
    NPatchInfo patch = { R(0, 0, 64, 64), 16, 16, 16, 16, NPATCH_NINE_PATCH };
    Vector2 strip[4] = { V2(160, 10), V2(180, 40), V2(200, 12), V2(230, 38) };
    Vector2 fan[5] = { V2(480, 155), V2(480, 180), V2(510, 175), V2(515, 145), V2(490, 130) };
    Vector2 tstrip[6] = { V2(530, 130), V2(530, 180), V2(550, 130), V2(550, 180), V2(570, 135), V2(575, 175) };
    Vector2 spline[5] = { V2(10, 220), V2(60, 260), V2(110, 210), V2(160, 270), V2(200, 220) };
    Vector2 quad[5] = { V2(640, 270), V2(660, 200), V2(690, 270), V2(720, 200), V2(750, 270) };
    Vector2 cubic[7] = { V2(10, 280), V2(60, 240), V2(110, 290), V2(160, 280), V2(210, 240), V2(260, 290), V2(310, 280) };
    for (int frame = 0; frame < 3; frame++) {
        BeginTextureMode(target);
        ClearBackground(SKYBLUE);
        DrawPoly(V2(30, 30), 12, 20, 0, RED);
        DrawRectangle(60, 10, 30, 20, DARKGREEN);
        DrawTriangleFan((Vector2[]){ V2(50, 55), V2(90, 55), V2(70, 35) }, 3, GOLD);
        EndTextureMode();
        BeginDrawing();
        ClearBackground(RAYWHITE);
        @CASES@
        rlDrawRenderBatchActive();
        if (frame == 2) ExportImage(LoadImageFromScreen(), "ref.png");
        EndDrawing();
    }
    CloseWindow();
    return 0;
}
