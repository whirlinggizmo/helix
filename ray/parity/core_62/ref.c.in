// raylib 6.2's file names, encodings, hashes and QuaternionFromVector3ToVector3, printed by parity.h; cases.py's list is put into it.
#include "parity.h"
#include "raymath.h"
#include <string.h>

// n bytes of text, 'a' to 'z' over and over.
static const char *filled(int n) {
    static char text[512];
    for (int i = 0; i < n; i++) text[i] = (char)('a' + i % 26);
    text[n] = 0;
    return text;
}

static void words(const char *name, const unsigned int *w, int n) {
    printf("%s hash", name);
    for (int i = 0; i < n; i++) printf(" %08x", w[i]);
    printf("\n");
}

static void sha1(const char *name, int n) { words(name, ComputeSHA1((const unsigned char *)filled(n), n), 5); }

static void b64(const char *name, const char *text) {
    int size = 0;
    unsigned char *bytes = DecodeDataBase64(text, &size);
    printf("%s base64 %d", name, size);
    for (int i = 0; i < size; i++) printf(" %d", bytes[i]);
    printf("\n");
    MemFree(bytes);
}

static void text(const char *name, const char *s) { printf("%s text %s\n", name, s && s[0] ? s : "-"); }
static void quat(const char *name, Quaternion q) { printf("%s quat %.9g %.9g %.9g %.9g\n", name, q.x, q.y, q.z, q.w); }

int main(void) {
    parity_open();
    @CASES@
    parity_close();
    return 0;
}
