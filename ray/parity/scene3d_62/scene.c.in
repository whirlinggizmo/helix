// The 3D scene Main.hx.in draws, drawn by raylib 6.2, its third frame saved as ref.png; cases.py's list is put into it. Its clip planes are
// 5.5's, as helix-ray's are (6.2 moved them to 0.05 and 4000, a choice helix-ray leaves as 5.5's).
#include "raylib.h"
#include "rlgl.h"
#define V2(x, y) ((Vector2){ (float)(x), (float)(y) })
#define V3(x, y, z) ((Vector3){ (float)(x), (float)(y), (float)(z) })
#define R(x, y, w, h) ((Rectangle){ (float)(x), (float)(y), (float)(w), (float)(h) })
static const char *VS = "#version 330\nin vec3 vertexPosition;\nin vec4 vertexTangent;\nin vec2 vertexTexCoord2;\nuniform mat4 mvp;\nout vec4 c;\n"
    "void main() { c = vec4(vertexTangent.xyz*0.5 + 0.5, 1.0) + vec4(vertexTexCoord2, 0.0, 0.0); gl_Position = mvp*vec4(vertexPosition, 1.0); }\n";
static const char *FS = "#version 330\nin vec4 c;\nout vec4 finalColor;\nvoid main() { finalColor = c; }\n";
int main(void) {
    SetTraceLogLevel(LOG_WARNING);
    InitWindow(640, 360, "scene");
    rlSetClipPlanes(0.01, 1000);
    Camera camera = { { 7, 6, 10 }, { 0, 0.5f, 0 }, { 0, 1, 0 }, 45, CAMERA_PERSPECTIVE };
    Texture2D checks = LoadTextureFromImage(GenImageChecked(64, 64, 8, 8, ORANGE, DARKBLUE));
    Image height = GenImageColor(8, 8, BLACK);
    for (int y = 0; y < 8; y++) for (int x = 0; x < 8; x++) ImageDrawPixel(&height, x, y, (Color){ (x * 37 + y * 23) % 256, (x * 37 + y * 23) % 256, (x * 37 + y * 23) % 256, 255 });
    Image cubic = GenImageColor(4, 3, BLACK);
    int walls[12] = { 1, 1, 1, 1, 1, 0, 0, 1, 1, 0, 1, 1 };
    for (int i = 0; i < 12; i++) ImageDrawPixel(&cubic, i % 4, i / 4, walls[i] ? WHITE : BLACK);
    Mesh meshes[11] = { GenMeshPoly(6, 0.6f), GenMeshPlane(1.2f, 1.2f, 3, 3), GenMeshCube(1, 1, 1), GenMeshSphere(0.6f, 10, 14),
        GenMeshHemiSphere(0.6f, 8, 12), GenMeshCylinder(0.5f, 1, 12), GenMeshCone(0.6f, 1.2f, 10), GenMeshTorus(0.3f, 1.2f, 16, 10),
        GenMeshKnot(1, 0.8f, 32, 8), GenMeshHeightmap(height, (Vector3){ 1.2f, 0.6f, 1.2f }), GenMeshCubicmap(cubic, (Vector3){ 0.3f, 0.4f, 0.3f }) };
    Model models[11];
    for (int i = 0; i < 11; i++) { models[i] = LoadModelFromMesh(meshes[i]); SetMaterialTexture(&models[i].materials[0], MATERIAL_MAP_DIFFUSE, checks); }
    Mesh tangent = GenMeshKnot(1, 0.8f, 32, 8);
    GenMeshTangents(&tangent);
    Model shaded = LoadModelFromMesh(tangent);
    Shader shader = LoadShaderFromMemory(VS, FS);
    shaded.materials[0].shader = shader;
    Vector3 strip[6] = { { -1, 0, 0.5f }, { -0.5f, 0, 0.5f }, { -1, 0.6f, 0.2f }, { -0.5f, 0.6f, 0.2f }, { -1, 1.2f, 0 }, { -0.5f, 1.2f, 0 } };
    for (int frame = 0; frame < 3; frame++) {
        BeginDrawing();
        ClearBackground(RAYWHITE);
        BeginMode3D(camera);
        DrawGrid(12, 1);
        @CASES@
        EndMode3D();
        rlDrawRenderBatchActive();
        if (frame == 2) ExportImage(LoadImageFromScreen(), "ref.png");
        EndDrawing();
    }
    CloseWindow();
    return 0;
}
