package helix.behavior;

import helix.behavior.BehaviorSchema;

/** The program's behavior classes by name, for a scene file's loader and an inspector: each subclass of Behavior registers itself as
	the program starts (its registration is generated by the build macro helix.macro.Behaviors), with its schema, how to make one and
	how to set and read its props by name, so nothing is found by reflection at run time. A file naming a behavior no class registered
	finds nothing here, and the loader logs it. */
class BehaviorRegistry {
	// Made by the first registration, with no initializer at all, not even null: a class registers from its __init__, which the targets
	// order differently against static initializers (JS runs every __init__ before the deferred ones, hxcpp runs some before a class's
	// boot and some after), so an initializer here could run after a registration and wipe it. Kept across a hot reload (@:hot): natively
	// a reload starts the project's plain statics over but runs no __init__ again for the classes it didn't reload, which would empty the
	// table; kept, a reloaded class registers again over its name.
	@:hot static var entries:Null<Map<String, BehaviorEntry>>;

	/** Registers a behavior class under name with its schema, make (a new instance), setProp and getProp (the generated setters and
		getters, by prop name). A later registration under the same name replaces the earlier: a hot reload registers each class again.
		Called by the generated code as the program starts; a game doesn't call it. */
	public static function register(name:String, make:Void->Behavior, schema:BehaviorSchema, setProp:(Behavior, String, Dynamic) -> Bool,
			getProp:(Behavior, String) -> Dynamic):Void {
		if (entries == null)
			entries = new Map();
		entries.set(name, new BehaviorEntry(schema, make, setProp, getProp));
	}

	/** The class registered under name, or null. */
	public static function find(name:String):Null<BehaviorEntry>
		return entries == null ? null : entries.get(name);

	/** The registered names, sorted (registration order differs between targets). */
	public static var names(get, never):Array<String>;

	static function get_names():Array<String> {
		var found = entries == null ? [] : [for (name in entries.keys()) name];
		found.sort((a, b) -> a < b ? -1 : a > b ? 1 : 0);
		return found;
	}

	/** Every registered class's schema, by name sorted: what an inspector lists. */
	public static var schemas(get, never):Array<BehaviorSchema>;

	static function get_schemas():Array<BehaviorSchema>
		return [for (name in names) entries.get(name).schema];
}

/** One registered behavior class: its schema, a new instance by make, and its props set and read by name through the setters and
	getters the build macro generated for the class, typed, with no reflection. */
class BehaviorEntry {
	var maker:Void->Behavior;
	var set:(Behavior, String, Dynamic) -> Bool;
	var get:(Behavior, String) -> Dynamic;

	@:allow(helix.behavior.BehaviorRegistry)
	function new(schema:BehaviorSchema, make:Void->Behavior, set:(Behavior, String, Dynamic) -> Bool, get:(Behavior, String) -> Dynamic) {
		this.schema = schema;
		this.maker = make;
		this.set = set;
		this.get = get;
	}

	/** The name it's registered under: the schema's. */
	public var name(get, never):String;

	function get_name():String
		return schema.name;

	/** Its props: names, types, defaults and ranges. */
	public var schema(default, null):BehaviorSchema;

	/** A new behavior of the class, its props at their defaults, in no pass. */
	public function make():Behavior
		return maker();

	/** Sets behavior's prop name to value. False, changing nothing, for a name the schema doesn't have, a value of the wrong type (a
		Float for an Int, a String for a number, a list with something but numbers in it, a node reference that isn't a Node3D or null),
		or a behavior that isn't of this class. */
	public function setProp(behavior:Behavior, name:String, value:Dynamic):Bool
		return set(behavior, name, value);

	/** Behavior's prop name as it is now; null for a name the schema doesn't have or a behavior that isn't of this class. */
	public function getProp(behavior:Behavior, name:String):Dynamic
		return get(behavior, name);
}
